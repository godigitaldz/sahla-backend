{
  "name": "sahla-backend",
  "version": "1.0.0",
  "description": "Sahla Food Delivery Backend API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "echo 'No build step required'",
    "sync:public": "node scripts/sync-public.js",
    "stamp:version": "node scripts/stamp-version.js",
    "test:download": "node scripts/test-download-page.js",
    "test:download-tracking": "node scripts/test-download-tracking.js",
    "test:tracking-api": "node --test src/routes/downloadTracking.test.js",
    "screenshot:download-funnel": "node scripts/capture-download-funnel.js",
    "test:safe": "node --test $(find src -name \"*.test.js\")",
    "test:web": "npm --prefix web test",
    "test": "node --env-file-if-exists=.env.production.local --test $(find src -name \"*.test.js\")"
  },
  "keywords": ["food", "delivery", "api", "supabase"],
  "author": "Sahla Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@upstash/qstash": "^2.10.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
