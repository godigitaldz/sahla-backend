{
  "version": 2,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(download\\.js|config\\.js|download\\.css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/(open|download|open\\.html|download\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ],
  "builds": [
    {
      "src": "web/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "src/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/api/internal/web-order-push/(.*)",
      "dest": "/api/internal/web-order-push/$1"
    },
    {
      "src": "/api/internal/(.*)",
      "dest": "src/index.js"
    },
    {
      "src": "/api/public/(system-urls|market-tab-enabled|app-version-policy|free-delivery-zone.*)",
      "dest": "src/index.js"
    },
    {
      "src": "/.well-known/(.*)",
      "dest": "src/index.js"
    },
    {
      "src": "/open(.*)",
      "dest": "src/index.js"
    },
    {
      "src": "/download(.*)",
      "dest": "src/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/public/(orders|restaurants|table|app-offer-delivery)(.*)",
      "dest": "/api/public/$1$2"
    },
    {
      "src": "/restaurants/(.*)",
      "dest": "/restaurants/$1"
    },
    {
      "src": "/t/(.*)",
      "dest": "/t/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "src/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "src/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/pending-orders-poll",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/internal/delivery-personnel/sync-working-hours",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/internal/delivery-personnel/sync-working-hours",
      "schedule": "0 21 * * *"
    }
  ]
}
