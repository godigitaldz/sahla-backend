# Sahla backend (Vercel) — required env for admin alerts + lifecycle

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Push gateway (required after Phase A auth)
PUSH_NOTIFICATION_INTERNAL_SECRET=
# Phase 2 web order push outbox drainer (also set on Supabase Edge Function secrets)
WEB_ORDER_PUSH_ENABLED=false

# Lifecycle QStash → https://www.sahla-delivery.com/api/internal/events/order-lifecycle
ORDER_LIFECYCLE_WEBHOOK_URL=https://www.sahla-delivery.com
# Legacy alias (optional fallback)
QSTASH_LIFECYCLE_CALLBACK_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Cron (GitHub Actions + Vercel cron every 2m)
CRON_SECRET=

# Supabase DB trigger (pg_net) → POST /api/internal/orders/lifecycle-sync on order insert
# and status / courier changes (migration 20260619150000).
# After migration 20260619140000, upsert in SQL Editor (token = production CRON_SECRET):
#   INSERT INTO public.order_lifecycle_sync_webhook (singleton_id, sync_url, sync_token)
#   VALUES (true, 'https://www.sahla-delivery.com/api/internal/orders/lifecycle-sync', '<CRON_SECRET>')
#   ON CONFLICT (singleton_id) DO UPDATE SET sync_url = EXCLUDED.sync_url,
#     sync_token = EXCLUDED.sync_token, updated_at = now();

# Optional: Vercel Deployment Protection bypass for QStash callbacks
VERCEL_AUTOMATION_BYPASS_SECRET=

# Public web ordering (Next.js app in /web — set on Vercel for web project)
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY must be available to Next builds.
# Apply DB migration: node scripts/apply_public_web_migration.js (requires SUPABASE_DB_URL)
# Enable a restaurant: UPDATE restaurants SET public_slug='my-restaurant', is_public_web_enabled=true WHERE id='...';

# Table orders staff portal (/table-orders/{code}) — per-restaurant password set in Performance admin
# Optional; falls back to PERFORMANCE_SESSION_SECRET
TABLE_ORDERS_SESSION_SECRET=

ADMIN_ORDER_ALERT_USER_IDS=4914521d-d1d1-4660-a120-a4f216600e7e

# Pickup-delay poller: parcel orders only (food orders use QStash lifecycle matrix)
ENABLE_PICKUP_DELAY_ADMIN_ALERTS=false
# PICKUP_DELAY_ADMIN_ALERT_FIRST_MINUTES=5
# PICKUP_DELAY_ADMIN_ALERT_SECOND_MINUTES=10
ENABLE_PARCEL_WAITING_ADMIN_ALERTS=true
ENABLE_ORDER_REBROADCAST_PUSHES=true
# Recurring courier rebroadcast every 3m (8m–23m) for preparing+unassigned orders
ENABLE_PREPARING_UNASSIGNED_REBROADCAST=true

# Lifecycle alert matrix (QStash): pending 2m/5m/10m/12m restaurant rebroadcast,
# preparing unassigned episode (courier_unassigned_episode_at): immediate + 2m/5m per episode,
# picked_up→delivered 25m; cron poller rebroadcasts couriers at 8/11/14/17/20/23m
